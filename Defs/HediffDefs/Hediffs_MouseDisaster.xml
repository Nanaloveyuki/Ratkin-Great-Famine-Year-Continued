<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>MouseDisaster_GnawedTreeBark</defName>
    <label>啃食树皮</label>
    <description>粗糙树皮划伤了口腔和消化道。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.2</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.15</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_GnawedWall</defName>
    <label>啃食墙皮</label>
    <description>墙灰与碎屑让身体暂时维持住了，但代价并不轻。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.2</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.35</painOffset>
        <hungerRateFactor>0.5</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_OverGnawedWall</defName>
    <label>过量啃食墙皮</label>
    <description>墙灰堵住了身体本能，几乎把这具小身体彻底拖垮。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.3</initialSeverity>
    <stages>
      <li>
        <painOffset>0.8</painOffset>
        <statFactors>
          <MaxNutrition>0.1</MaxNutrition>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.6</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_TemporaryShelterMark</defName>
    <label>鼠灾临时收留</label>
    <description>这名鼠灾访客目前正被殖民地临时收留。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_HiredWorkerMark</defName>
    <label>鼠灾长工</label>
    <description>这名鼠灾访客目前以长工身份留在殖民地。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_DisasterRefugeeMark</defName>
    <label>鼠灾难民</label>
    <description>这名鼠族来自大荒年灾荒，是因饥荒而流离失所的灾民。它们饥饿、瘦弱，正在寻求食物和庇护。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0</severityPerDay>
      </li>
    </comps>
  </HediffDef>
</Defs>
